# Production settings read by docker-compose.yml. Copy to .env and fill in.
# (Local development needs none of this: see README.)

# Domain pointing at the server (DNS A record). Use "localhost" to try the stack locally.
SITE_ADDRESS=club.example.com

# Long random strings, e.g. `openssl rand -base64 48`.
POSTGRES_PASSWORD=
JWT_SECRET=

# First admin account, created on first start (sign in with this phone + password).
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=Club Admin

# Contact e-mail sent to OpenStreetMap Nominatim with place searches (their usage policy).
GEOCODER_EMAIL=

# Map tiles. Default: Stadia Maps dark (register SITE_ADDRESS on stadiamaps.com, free tier).
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
MAP_TILE_ORIGIN=https://tiles.stadiamaps.com

TZ=Africa/Tunis
