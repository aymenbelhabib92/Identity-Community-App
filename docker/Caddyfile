# One domain serves the web app and the API (/api/*). Caddy gets and renews the
# HTTPS certificate on its own — PWAs, geolocation and the camera need HTTPS.
# SITE_ADDRESS: your domain (e.g. club.example.com), "localhost" to try locally, or ":80"
# behind another reverse proxy that handles HTTPS (docker-compose.proxy.yml).

# TRUSTED_PROXIES: the reverse proxy in front of Caddy, if any ("private_ranges" for a proxy
# on the Docker network): the visitor's IP is then read from its X-Forwarded-For header.
# Otherwise no one is trusted and the visitor's IP is the connection's.
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
		-Server
	}

	handle /api/* {
		# A single, verified visitor IP: the API trusts X-Forwarded-For (rate limits).
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv

		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$MAP_TILE_ORIGIN:https://tiles.stadiamaps.com}; connect-src 'self' {$MAP_TILE_ORIGIN:https://tiles.stadiamaps.com}; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

		# Hashed build files never change; everything else (index.html for every route,
		# the service worker, the manifest) is revalidated so updates reach members.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
