# API base URL. Keep the default when the web app and the API share a domain
# (Vite proxy in development, Caddy in Docker).
VITE_API_URL=/api/v1

# Map tiles (Leaflet). Defaults to Stadia Maps "Alidade Smooth Dark": free and
# keyless on localhost; in production register your domain on stadiamaps.com
# (free tier) or use another provider's URL here.
VITE_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=&copy; Stadia Maps &copy; OpenMapTiles &copy; OpenStreetMap
