# API base URL. Keep the default when the web app and the API share a domain
# (Vite proxy in development, Caddy in Docker).
VITE_API_URL=/api/v1

# Map tiles (Leaflet). Defaults to CARTO's free dark basemap on OpenStreetMap data.
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
