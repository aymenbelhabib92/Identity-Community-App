# Copy to .env for local development. Every value is optional in development.

# PostgreSQL connection. Leave empty to use the embedded PGlite database stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Where payment proofs are stored.
UPLOAD_DIR=./data/uploads

# Required in production: a long random string (openssl rand -base64 48).
JWT_SECRET=

HOST=0.0.0.0
PORT=3000

# Club time zone: dues periods and "today" are computed in it.
TZ=Africa/Tunis

# Public URL of the web app (used in pass QR codes).
PUBLIC_URL=http://localhost:5173

# Extra origins allowed to call the API from a browser (comma separated). Not needed
# when the web app is served from the same domain or through the Vite proxy.
CORS_ORIGINS=

# Place search (OpenStreetMap Nominatim). Restrict results to these countries.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_COUNTRY_CODES=tn
GEOCODER_EMAIL=

# First admin account, created at startup when no admin exists yet.
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=Club Admin
